# Meditation cycle configuration — copy to meditation.env and adjust for your
# installation. No secrets belong in this file.
DAILY_BUDGET_USD=5.00
MAX_CONSECUTIVE_FAILS=5
ENABLED_RONINS="bow,sword,brush,arts"
VALIDATE_CMD="python execution/doctor.py"
RUN_HOURS=6
MAX_CYCLES=60
MAX_TURNS=80
CYCLE_TIMEOUT=2400
CYCLE_COST_USD=0.08
COOLDOWN=15
OLLAMA_BASE="http://localhost:11434/v1"
RONIN_LOCAL_MODEL="<your-local-model-tag>"
MEDITATION_AUTO_STASH=0
