{
 "version": 1,
 "name": "Order Samurai Root Hygiene Policy",
 "directories": {
  "live": [
   "execution",
   "agentica_core",
   "scouts"
  ],
  "support": [
   "Research",
   "backlog",
   "bin",
   "config",
   "docs",
   "evalsuite",
   "harness",
   "prompts",
   "reports",
   "soji",
   "tests"
  ],
  "state": [
   ".claude",
   ".mex",
   ".omc",
   ".pytest_cache",
   ".ruff_cache",
   ".tmp",
   "artifacts",
   "state"
  ],
  "metadata": [
   ".git"
  ],
  "archive": [
   "archive",
   "playground",
   "scratch"
  ],
  "dependency": [
   "node_modules"
  ]
 },
 "files": {
  "metadata": [
   ".DS_Store",
   ".gitignore",
   ".quality_register.md",
   "CLAUDE.md",
   "HANDOFF-worktree-isolation.md",
   "HANDOFF.md",
   "HERO-METRICS-PLAN.md",
   "PLAN-REVIEW-LOG.md",
   "PLAN-worktree-isolation.md",
   "PLAN.md",
   "PROJECT.md",
   "RONIN-DETERMINIZATION-PLAN.md",
   "RONIN-MECHANISM-ROUTE-DRAFT.md",
   "RONIN-MECHANISM-ROUTE-PLAN.md",
   "RONIN_SPEC.md"
  ],
  "support": [
   "meditation.env",
   "pyproject.toml",
   "research_insights.md"
  ]
 },
 "requiredDirectories": [
  "backlog",
  "config",
  "execution",
  "reports",
  "tests"
 ],
 "requiredFiles": [
  "PROJECT.md",
  "RONIN_SPEC.md"
 ],
 "boundaryRules": [
  {
   "name": "archive-isolation",
   "scanPaths": [
    "execution"
   ],
   "forbiddenRoots": [
    "archive",
    "playground",
    "scratch"
   ],
   "description": "Live runtime code must not depend on archive or exploratory roots."
  }
 ]
}