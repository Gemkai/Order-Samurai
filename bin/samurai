#!/usr/bin/env python3
"""
Order Samurai CLI & Installer Tool
Provides samurai install, samurai doctor, and samurai uninstall capabilities.
"""

import os
import sys
import json
import shutil
import datetime
import argparse
from pathlib import Path

SAMURAI_VERSION = "1.0.2"

GUARD_MARKER = "prompt_injection_guard"
SCRUBBER_MARKER = "secret_scrubber_realtime"

# Tool patterns the guard and scrubber are scoped to. Claude Code matches these
# against the tool name for each PreToolUse/PostToolUse event.
GUARD_MATCHER = "Bash|Write|Edit|MultiEdit|WebFetch"
SCRUBBER_MATCHER = "Bash|Read|WebFetch"

def get_paths():
    home = Path.home()
    samurai_root = Path(os.environ.get("SAMURAI_ROOT", Path(__file__).resolve().parent.parent))
    samurai_home = Path(os.environ.get("SAMURAI_HOME", home / ".samurai"))
    samurai_settings = samurai_home / "settings.json"
    claude_hooks = home / ".claude" / "hooks"
    # Claude Code loads ~/.claude/settings.json. It does NOT read
    # ~/.claude/hooks/settings.json -- registering there (as v1.0.0 did) means
    # the guard never fires. See tests/test_hook_wiring.py.
    claude_settings = home / ".claude" / "settings.json"
    backups_dir = samurai_home / "backups"
    
    return {
        "root": samurai_root,
        "home": samurai_home,
        "samurai_settings": samurai_settings,
        "claude_hooks": claude_hooks,
        "claude_settings": claude_settings,
        "backups": backups_dir,
        "state": samurai_root / "state",
        "taxonomy": samurai_root / "state" / "kill_chain_taxonomy.json"
    }

def _backup(settings_path: Path, backups_dir: Path, label: str):
    """Back up settings_path under a label unique to its target.

    The label matters: both target files are named settings.json, so a shared
    backup name lets an uninstall restore the wrong one over the user's real
    Claude Code config.
    """
    if not settings_path.exists():
        return
    backups_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_file = backups_dir / f"{label}.bak.{ts}"
    shutil.copy2(settings_path, backup_file)
    print(f"  [✓] Backed up prior settings to {backup_file}")


def _load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        with open(path, "r") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _write_json(path: Path, data: dict):
    """Write atomically -- the Claude Code config is large and user-owned."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def _entry_targets(entry: dict, marker: str) -> bool:
    """True when a Claude-Code-shaped entry runs one of our scripts."""
    if not isinstance(entry, dict):
        return False
    for hook in entry.get("hooks", []) or []:
        if isinstance(hook, dict) and marker in str(hook.get("command", "")):
            return True
    return False


def _register_claude_hooks(settings_path: Path, guard_script: str, scrubber_script: str, backups_dir: Path, target_label: str = "claude-settings"):
    """Register into ~/.claude/settings.json using Claude Code's own schema.

    Entries take the form {"matcher": ..., "hooks": [{"type": "command", ...}]}.
    Merges into the existing config: unrelated keys and the user's own hooks are
    preserved, and re-running replaces our entries rather than duplicating them.
    """
    _backup(settings_path, backups_dir, target_label)
    settings = _load_json(settings_path)

    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}

    for event, marker, matcher, script in (
        ("PreToolUse", GUARD_MARKER, GUARD_MATCHER, guard_script),
        ("PostToolUse", SCRUBBER_MARKER, SCRUBBER_MATCHER, scrubber_script),
    ):
        script_marker = Path(script).name
        entries = [e for e in (hooks.get(event) or []) if not (_entry_targets(e, marker) or _entry_targets(e, script_marker))]
        entries.append({
            "matcher": matcher,
            "hooks": [{
                "type": "command",
                "command": f"python3 {script}",
                "timeout": 5000,
            }],
        })
        hooks[event] = entries

    settings["hooks"] = hooks
    _write_json(settings_path, settings)
    print(f"  [✓] Registered hooks in {settings_path}")


def _register_hooks_in_file(settings_path: Path, guard_script: str, scrubber_script: str, backups_dir: Path, target_label: str = "samurai-settings"):
    """Agent-agnostic registration for ~/.samurai/settings.json.

    Kept for non-Claude harnesses. This file is NOT what Claude Code reads --
    `samurai doctor` must never treat its contents as proof of protection.
    """
    _backup(settings_path, backups_dir, target_label)
    existing_settings = _load_json(settings_path)

    hooks = existing_settings.get("hooks", {})
    pre_hooks = hooks.get("PreToolUse", [])
    post_hooks = hooks.get("PostToolUse", [])

    samurai_pre = {"name": "samurai_prompt_injection_guard", "command": f"python3 {guard_script}", "async": False}
    samurai_post = {"name": "samurai_secret_scrubber", "command": f"python3 {scrubber_script}", "async": False}

    pre_hooks = [h for h in pre_hooks if isinstance(h, dict) and h.get("name") != "samurai_prompt_injection_guard"]
    post_hooks = [h for h in post_hooks if isinstance(h, dict) and h.get("name") != "samurai_secret_scrubber"]

    pre_hooks.append(samurai_pre)
    post_hooks.append(samurai_post)

    hooks["PreToolUse"] = pre_hooks
    hooks["PostToolUse"] = post_hooks
    existing_settings["hooks"] = hooks

    _write_json(settings_path, existing_settings)
    print(f"  [✓] Registered hooks in {settings_path}")

def cmd_install(args):
    paths = get_paths()
    print(f"⚔️  Installing Order Samurai v{SAMURAI_VERSION}...")

    paths["home"].mkdir(parents=True, exist_ok=True)
    paths["backups"].mkdir(parents=True, exist_ok=True)

    guard_script = str(paths["root"] / "hooks" / "prompt_injection_guard.py")
    scrubber_script = str(paths["root"] / "hooks" / "secret_scrubber_realtime.py")

    # Agent-agnostic record for non-Claude harnesses.
    _register_hooks_in_file(paths["samurai_settings"], guard_script, scrubber_script, paths["backups"])

    # The one that actually enforces anything: Claude Code's own config. Always
    # written -- if Claude Code is installed later, the guard is already wired.
    _register_claude_hooks(paths["claude_settings"], guard_script, scrubber_script, paths["backups"])

    print(f"⚔️  Installation complete! Run 'samurai doctor' to verify system health.")
    return 0

def cmd_doctor(args):
    paths = get_paths()
    print(f"🩺 Order Samurai Doctor v{SAMURAI_VERSION}")
    print("----------------------------------------")

    total = 5
    passed = 0

    def check(name, ok, detail=""):
        nonlocal passed
        status = "[✅ PASS]" if ok else "[❌ FAIL]"
        if ok:
            passed += 1
        print(f"{status} {name}: {detail}")

    # Check 1: Python Version
    py_ok = sys.version_info >= (3, 10)
    check("Python Version", py_ok, f"Python {sys.version.split()[0]} (>= 3.10 required)")

    # Check 2: Taxonomy File
    tax_ok = paths["taxonomy"].exists()
    if tax_ok:
        try:
            with open(paths["taxonomy"]) as f:
                data = json.load(f)
                tax_ok = len(data.get("chains", [])) == 14
        except Exception:
            tax_ok = False
    check("Kill Chain Taxonomy", tax_ok, f"{paths['taxonomy']} (14 chains)")

    # Check 3: Fail-Closed Posture
    fail_open = os.environ.get("BUSHIDO_FAIL_OPEN", "false").lower() == "true"
    check("Security Posture", not fail_open, f"BUSHIDO_FAIL_OPEN={fail_open} (Fail-closed enforced)")

    # Check 4: Hook Registration.
    # Asserted ONLY against ~/.claude/settings.json in Claude Code's own schema.
    # v1.0.0 accepted ~/.samurai/settings.json as proof and reported PASS while
    # the guard was wired nowhere Claude Code would ever load it.
    claude_settings = paths["claude_settings"]
    pre = _load_json(claude_settings).get("hooks", {}).get("PreToolUse", []) or []
    registered = any(_entry_targets(e, GUARD_MARKER) for e in pre)
    detail = (
        f"PreToolUse guard registered in {claude_settings}"
        if registered
        else f"NOT registered in {claude_settings} -- run 'samurai install'"
    )
    check("Claude Code Hook Registration", registered, detail)

    # Check 5: Path Authority
    root_ok = paths["root"].exists() and (paths["root"] / "agentica_core").exists()
    check("Path Authority", root_ok, f"Root: {paths['root']}")

    print("----------------------------------------")
    print(f"Summary: {passed}/{total} checks passed.")
    return 0 if passed == total else 1

def cmd_uninstall(args):
    paths = get_paths()
    print(f"⚔️  Uninstalling Order Samurai v{SAMURAI_VERSION}...")

    # 1. Surgically deregister our own entries, leaving the user's hooks intact.
    #    Deliberately NOT a restore-from-backup: both settings files share a
    #    basename, so restoring "the newest backup" could drop ~/.samurai's file
    #    on top of the user's real Claude Code config. Backups are kept on disk
    #    for manual recovery instead.
    for label, settings_path, shaped in (
        ("Claude Code", paths["claude_settings"], True),
        ("agent-agnostic", paths["samurai_settings"], False),
    ):
        if not settings_path.exists():
            continue
        try:
            cfg = _load_json(settings_path)
            hooks = cfg.get("hooks", {})
            if not isinstance(hooks, dict):
                continue
            for event, marker, legacy_name in (
                ("PreToolUse", GUARD_MARKER, "samurai_prompt_injection_guard"),
                ("PostToolUse", SCRUBBER_MARKER, "samurai_secret_scrubber"),
            ):
                entries = hooks.get(event) or []
                if shaped:
                    entries = [e for e in entries if not _entry_targets(e, marker)]
                else:
                    entries = [
                        e for e in entries
                        if not (isinstance(e, dict) and e.get("name") == legacy_name)
                    ]
                # Also strip v1.0.0's mis-shaped entries wherever they linger.
                entries = [
                    e for e in entries
                    if not (isinstance(e, dict) and e.get("name") == legacy_name)
                ]
                hooks[event] = entries
            cfg["hooks"] = hooks
            _write_json(settings_path, cfg)
            print(f"  [✓] Deregistered Order Samurai hooks from {label} settings.")
        except Exception as e:
            print(f"  [!] Error deregistering hooks from {label} settings: {e}")

    # 2. Clean up v1.0.0's stray file, which Claude Code never read anyway.
    stray = paths["claude_hooks"] / "settings.json"
    if stray.exists():
        try:
            stray.unlink()
            print(f"  [✓] Removed stale v1.0.0 hook file {stray}")
        except Exception as e:
            print(f"  [!] Could not remove {stray}: {e}")

    # 3. Handle data cleanup. license.json is a paid entitlement -- preserve a
    #    copy rather than silently destroying it with the state directory.
    if not args.keep_data and paths["home"].exists():
        license_file = paths["home"] / "license.json"
        if license_file.exists():
            rescued = Path.home() / "order-samurai-license-backup.json"
            try:
                shutil.copy2(license_file, rescued)
                print(f"  [✓] Saved your Pro license to {rescued}")
            except Exception as e:
                print(f"  [!] Could not preserve license.json: {e}")
                print("  [!] Aborting removal so your license is not lost. Re-run with --keep-data.")
                return 1
        shutil.rmtree(paths["home"])
        print("  [✓] Removed ~/.samurai state (Zero-residue audit PASS).")
    elif args.keep_data:
        print("  [i] Kept ~/.samurai data (--keep-data specified).")

    print("⚔️  Order Samurai uninstalled cleanly.")
    return 0

def main():
    parser = argparse.ArgumentParser(description="Order Samurai Governance CLI")
    subparsers = parser.add_subparsers(dest="command")

    # install
    subparsers.add_parser("install", help="Install & register Order Samurai hooks")

    # doctor
    subparsers.add_parser("doctor", help="Run diagnostic health checks")

    # uninstall
    un_parser = subparsers.add_parser("uninstall", help="Uninstall Order Samurai hooks and restore settings")
    un_parser.add_argument("--keep-data", action="store_true", help="Preserve ~/.samurai state directory")

    args = parser.parse_args()
    if not args.command or args.command == "doctor":
        sys.exit(cmd_doctor(args))
    elif args.command == "install":
        sys.exit(cmd_install(args))
    elif args.command == "uninstall":
        sys.exit(cmd_uninstall(args))
    else:
        parser.print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
