#!/usr/bin/env python3
"""
Order Samurai CLI & Installer Tool
Provides samurai install, samurai doctor, and samurai uninstall capabilities.
"""

import os
import re
import sys
import copy
import json
import stat
import time
import shlex
import shutil
import fcntl
import datetime
import tempfile
import contextlib
import subprocess
import argparse
import importlib.util
import getpass
from pathlib import Path

SAMURAI_VERSION = "2.1.3"

# Tool patterns the guard and scrubber are scoped to. Claude Code matches these
# against the tool name for each PreToolUse/PostToolUse event.
GUARD_MATCHER = "Bash|Write|Edit|MultiEdit|WebFetch"
SCRUBBER_MATCHER = "Bash|Read"  # post-mode ignores WebFetch output
# Claude Code hook `timeout` is in seconds (https://code.claude.com/docs/en/hooks.md).
# The guard makes one 3s local-LLM call and fails open, so 10s is ample.
GUARD_TIMEOUT_S = 10
SCRUBBER_TIMEOUT_S = 10

def _licensing_module():
    """Import agentica_core.licensing, resolving its sibling-vs-child location the
    same way cmd_doctor's Path Authority check does: live tree
    has agentica_core as a SIBLING of Order Samurai under Governance/; a flattened
    export has it as a direct CHILD of the repo root. Import lazily so `samurai
    doctor`/`install`/`uninstall` never pay for this or fail when agentica_core is
    absent (e.g. a partial checkout)."""
    root = get_paths()["root"]
    for governance_dir in (root.parent, root):
        if (governance_dir / "agentica_core").is_dir():
            if str(governance_dir) not in sys.path:
                sys.path.insert(0, str(governance_dir))
            import agentica_core.licensing as licensing  # noqa: PLC0415
            return licensing
    print("  [!] Could not locate agentica_core/licensing.py — is the checkout complete?", file=sys.stderr)
    sys.exit(1)


def _is_interactive():
    """A person is at a terminal: stdout is a TTY and /dev/tty can be opened. Under
    `curl ... | bash` stdin is the script, but /dev/tty still reaches the person."""
    if not sys.stdout.isatty():
        return False
    try:
        import termios  # noqa: PLC0415
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except (ImportError, OSError):
        return False
    try:
        termios.tcgetattr(fd)  # getpass would otherwise fall back to reading stdin
        return True
    except termios.error:
        return False
    finally:
        os.close(fd)


def _read_hidden(prompt_text):
    """Read a secret without echo. getpass reads /dev/tty, not stdin."""
    return getpass.getpass(prompt_text)


def _self_cmd():
    """How to run this CLI again: `samurai` if that is on PATH, else its full path."""
    me = Path(__file__).resolve()
    found = shutil.which("samurai")
    if found and Path(found).resolve() == me:
        return "samurai"
    return f"python3 {shlex.quote(str(me))}"


def _mask(key):
    return f"****{key[-4:]}" if key and len(key) >= 8 else "****"


def _key_from_sources(positional):
    """Positional arg > SAMURAI_LICENSE_KEY > hidden prompt > one line of stdin."""
    if positional:
        return positional.strip()
    env_key = os.environ.get("SAMURAI_LICENSE_KEY", "").strip()
    if env_key:
        return env_key
    if _is_interactive() or sys.stdin.isatty():
        return (_read_hidden("Paste your Order Samurai Pro license key (input hidden): ") or "").strip()
    return (sys.stdin.readline() or "").strip()


def cmd_activate(args):
    key = _key_from_sources(getattr(args, "license_key", None))
    if not key:
        print("❌ no license key provided. Paste it when asked, or: "
              "printf %s \"$KEY\" | samurai activate", file=sys.stderr)
        return 1
    licensing = _licensing_module()
    result = licensing.activate(key, instance_name=getattr(args, "instance_name", None))
    msg = result.get("message", "").replace(key, _mask(key))
    if result.get("ok"):
        print(f"⚔️  {msg} (key {_mask(key)})")
        return 0
    print(f"❌ {msg}")
    return 1


_ACTIVATION_ATTEMPTS = 3


def _offer_pro_activation(args):
    """End of `samurai install`: turn install + upgrade into one command.

    Never fails the install: a Free install is still a successful install."""
    licensing = _licensing_module()
    env_key = os.environ.get("SAMURAI_LICENSE_KEY", "").strip()
    if not env_key:
        if licensing.is_pro():
            print("⚔️  Order Samurai Pro is already active on this machine.")
            return
        if getattr(args, "no_activate", False) or os.environ.get("SAMURAI_NO_PROMPT") == "1":
            return
        if not _is_interactive():
            print(f"   Have a Pro license key? Run: {_self_cmd()} activate")
            return
        print("")
        print("⚔️  Order Samurai Pro: paste the license key from your Gumroad receipt,")
        print("   or press Enter to stay on the Free tier.")

    for attempt in range(1, _ACTIVATION_ATTEMPTS + 1):
        key = env_key or (_read_hidden("   License key (input hidden): ") or "").strip()
        if not key:
            print("   Staying on Free. Upgrade any time with: " + _self_cmd() + " activate")
            return
        result = licensing.activate(key, instance_name=None)
        msg = str(result.get("message", "")).replace(key, _mask(key))
        if result.get("ok"):
            print(f"⚔️  Order Samurai Pro activated (key {_mask(key)}).")
            return
        print(f"❌ {msg}")
        retryable = msg.startswith("license key invalid") and not env_key
        if not retryable:
            if msg.startswith("network error"):
                print(f"   Couldn't reach Gumroad. Activate later with: {_self_cmd()} activate")
            else:
                print(f"   Activate later with: {_self_cmd()} activate")
            return
        if attempt < _ACTIVATION_ATTEMPTS:
            print("   Check the key on your Gumroad receipt and paste it again (or press Enter to skip).")
    print(f"   Staying on Free. Activate later with: {_self_cmd()} activate")


def cmd_deactivate(args):
    licensing = _licensing_module()
    result = licensing.deactivate()
    print(("⚔️  " if result.get("ok") else "❌ ") + result.get("message", ""))
    return 0 if result.get("ok") else 1


def cmd_license(args):
    licensing = _licensing_module()
    if getattr(args, "refresh", False):
        # Re-check with the payment provider now (no seat used). Offline never revokes.
        res = licensing.revalidate(force=True)
        print(f"Re-check: {res.get('result')} (tier {str(res.get('tier', 'free')).upper()})")
    st = licensing.status()
    print(f"Tier: {st.get('tier', 'free').upper()}")
    if st.get("activated"):
        print(f"  Provider:    {st.get('provider', 'gumroad')}")
        print(f"  License key: {st.get('license_key')}")
        print(f"  Instance:    {st.get('instance_name')}")
        print(f"  Email:       {st.get('customer_email')}")
        print(f"  Activated:   {st.get('activated_at')}")
    elif st.get("reason"):
        print(f"  {st['reason']}")
    return 0

def get_paths():
    home = Path.home()
    samurai_root = Path(os.environ.get("SAMURAI_ROOT", Path(__file__).resolve().parent.parent))
    samurai_home = Path(os.environ.get("SAMURAI_HOME", home / ".samurai"))
    samurai_settings = samurai_home / "settings.json"
    claude_hooks = home / ".claude" / "hooks"
    # Claude Code loads ~/.claude/settings.json. It does NOT read
    # ~/.claude/hooks/settings.json -- registering there (as v1.0.0 did) means
    # the guard never fires. See tests/test_hook_wiring.py.
    claude_settings = home / ".claude" / "settings.json"
    backups_dir = samurai_home / "backups"

    return {
        "root": samurai_root,
        "home": samurai_home,
        "samurai_settings": samurai_settings,
        "claude_hooks": claude_hooks,
        "claude_settings": claude_settings,
        "backups": backups_dir,
        "state": samurai_root / "state",
        "taxonomy": samurai_root / "state" / "kill_chain_taxonomy.json"
    }


# --- Harnesses -----------------------------------------------------------------
#
# Claude Code and Codex both load PreToolUse command hooks from a JSON file with
# the same shape. Detection only chooses install targets; doctor and uninstall act
# on what ~/.samurai/install.json recorded, so a harness removed later is still
# cleaned up and a past --harness choice is remembered.

HARNESSES = ("claude", "codex")
HARNESS_LABELS = {"claude": "Claude Code", "codex": "Codex"}
CONFIG_BACKUP_LABELS = {"claude": "claude-settings", "codex": "codex-hooks"}
CODEX_APP_BIN_DEFAULT = "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex"
# Codex matches tool names with a regex; Bash and apply_patch carry their text in
# tool_input.command, which is what the guard scans.
CODEX_GUARD_MATCHER = "^(Bash|apply_patch)$"
GUARD_SCRIPT = "prompt_injection_guard.py"
SCRUBBER_SCRIPT = "secret_scrubber_realtime.py"
# What v2.1.0-v2.1.3 wrote (Claude only, no manifest): adopted only on an exact match.
LEGACY_TIMEOUT = 5000
LEGACY_SCRUBBER_MATCHER = "Bash|Read|WebFetch"
CODEX_NOT_VERIFIED = "guard installed and working when run directly; Codex enforcement not verified by doctor"


class UnsafeFile(Exception):
    """The target is a symlink or not a regular file; Samurai will not replace it."""


class ConcurrentModification(Exception):
    """The file changed while Samurai was updating it, twice in a row."""


class Refusal(Exception):
    """Our recorded hook is missing, duplicated or edited; changing it could hurt the user's config."""


class MissingHook(Refusal):
    """No unmodified copy of our recorded hook is left in the config."""


class SelectionError(Exception):
    """--harness / SAMURAI_HARNESS named something Samurai does not support."""


def _checkpoint(step, harness=None, path=None):
    """Called after each durable install/uninstall step (test seam; no-op)."""


def codex_home() -> Path:
    """Codex's state root: $CODEX_HOME when set, else ~/.codex."""
    raw = os.environ.get("CODEX_HOME", "")
    return Path(os.path.abspath(raw)) if raw else Path.home() / ".codex"


def _codex_app_bin() -> Path:
    return Path(os.environ.get("SAMURAI_CODEX_APP_BIN") or CODEX_APP_BIN_DEFAULT)


def _is_executable_file(path) -> bool:
    return os.path.isfile(path) and os.access(path, os.X_OK)


def _on_path(name):
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, name)
        if directory and _is_executable_file(candidate):
            return candidate
    return None


def detect_harnesses() -> dict:
    """Runtime evidence per harness. Reads ~/.claude, PATH, the ChatGPT app's bundled
    codex and the Codex home, nothing else. A Codex config directory alone is not a
    runtime: it is reported as config_only and skipped."""
    claude_dir = Path.home() / ".claude"
    found = None if claude_dir.is_dir() else _on_path("claude")
    claude = {"present": claude_dir.is_dir() or bool(found),
              "evidence": f"claude on PATH ({found})" if found else str(claude_dir)}
    codex_bin = _on_path("codex")
    app = _codex_app_bin()
    if codex_bin:
        codex = {"present": True, "evidence": f"codex on PATH ({codex_bin})", "config_only": False}
    elif _is_executable_file(app):
        codex = {"present": True, "evidence": str(app), "config_only": False}
    else:
        codex = {"present": False, "evidence": "no codex on PATH or in the ChatGPT app",
                 "config_only": codex_home().is_dir()}
    return {"claude": claude, "codex": codex}


def _parse_harnesses(raw, source):
    chosen = []
    for part in str(raw).split(","):
        name = part.strip().lower()
        if not name:
            continue
        if name not in HARNESSES:
            raise SelectionError(f"unknown harness {name!r} in {source} (choose from: {', '.join(HARNESSES)})")
        if name not in chosen:
            chosen.append(name)
    if not chosen:
        raise SelectionError(f"no harness named in {source} (choose from: {', '.join(HARNESSES)})")
    return chosen


def _explicit_selection(args):
    """--harness beats SAMURAI_HARNESS; None when neither names anything."""
    flag = getattr(args, "harness", None)
    if flag is not None:
        return _parse_harnesses(flag, "--harness"), "flag"
    env = os.environ.get("SAMURAI_HARNESS", "")
    if env.strip():
        return _parse_harnesses(env, "SAMURAI_HARNESS"), "env"
    return None, None


# --- Hook definitions ---------------------------------------------------------

def _command(root, script):
    return "python3 " + shlex.quote(str(Path(root) / "bin" / script))


def _group(matcher, command, timeout):
    return {"matcher": matcher, "hooks": [{"type": "command", "command": command, "timeout": timeout}]}


def hook_definitions(harness, root):
    """(event, group) pairs Samurai writes for a harness. Codex gets the guard only:
    the secret scrubber is not mirrored to Codex."""
    guard = _group(GUARD_MATCHER if harness == "claude" else CODEX_GUARD_MATCHER,
                   _command(root, GUARD_SCRIPT), GUARD_TIMEOUT_S)
    if harness == "codex":
        return [("PreToolUse", guard)]
    return [("PreToolUse", guard),
            ("PostToolUse", _group(SCRUBBER_MATCHER, _command(root, SCRUBBER_SCRIPT), SCRUBBER_TIMEOUT_S))]


def _known_definitions(harness, roots):
    """Every exact group an earlier or current Samurai wrote for this harness, per event."""
    known = {}
    for root in roots:
        for event, group in hook_definitions(harness, root):
            known.setdefault(event, []).append(group)
        if harness == "claude":
            known["PreToolUse"].append(_group(GUARD_MATCHER, _command(root, GUARD_SCRIPT), LEGACY_TIMEOUT))
            known["PostToolUse"].append(_group(LEGACY_SCRUBBER_MATCHER, _command(root, SCRUBBER_SCRIPT), LEGACY_TIMEOUT))
    return known


def _owned_roots(paths, manifest):
    roots = [str(paths["root"]), str(paths["home"] / "core"), *manifest.get("roots", [])]
    return list(dict.fromkeys(roots))


# --- Safe file writes -----------------------------------------------------------

def _read_regular(path):
    """(bytes, mode) of a regular file, (None, None) when absent. Never follows a symlink."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None, None
    if not stat.S_ISREG(st.st_mode):
        raise UnsafeFile(f"{path} is a symlink or not a regular file; Samurai will not replace it")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as fh:
        return fh.read(), stat.S_IMODE(st.st_mode)


def _parse_json_bytes(raw, path):
    if raw is None or not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError as e:
        raise ValueError(f"{path} is not valid JSON ({e})") from None


def _write_backup(raw, backups_dir, label):
    backups_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    fd, name = tempfile.mkstemp(prefix=f"{label}.bak.{ts}.", dir=backups_dir)
    with os.fdopen(fd, "wb") as fh:
        fh.write(raw)
    return Path(name)


def _backup(settings_path: Path, backups_dir: Path, label: str):
    """Back up settings_path under a label unique to its target. Names never collide:
    both target files are named settings.json, and two runs can share a second."""
    if not os.path.isfile(settings_path) or os.path.islink(settings_path):
        return
    backup_file = _write_backup(Path(settings_path).read_bytes(), backups_dir, label)
    print(f"  [✓] Backed up prior settings to {backup_file}")


def _update_json_file(path, mutate, backup=None):
    """Atomically replace a JSON file with mutate(current data).

    The new content goes to a unique temp file in the same directory and keeps the
    original mode (0600 for a new file). Just before the replace the file is read
    again: if anyone changed it since it was read, the whole update is redone once
    on the new content, then ConcurrentModification is raised. Editors that ignore
    Samurai's lock can still race in the gap between that check and the rename.
    Returns "unchanged" (nothing written) or "written"."""
    path = Path(path)
    for _attempt in range(2):
        raw, mode = _read_regular(path)
        data = _parse_json_bytes(raw, path)
        new = mutate(copy.deepcopy(data))
        if raw is not None and new == data:
            return "unchanged"
        if backup is not None and raw is not None:
            _write_backup(raw, *backup)
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write((json.dumps(new, indent=2) + "\n").encode("utf-8"))
                fh.flush()
                os.fsync(fh.fileno())
            os.chmod(tmp, mode if mode is not None else 0o600)
            _checkpoint("before_replace", path=path)
            if _read_regular(path)[0] != raw:
                continue
            os.replace(tmp, path)
            return "written"
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp)
    raise ConcurrentModification(f"{path} changed while Samurai was updating it; re-run when it is idle")


@contextlib.contextmanager
def _state_lock(paths, wait_s=30.0):
    """Serialize Samurai's own writers on $SAMURAI_HOME/.lock."""
    paths["home"].mkdir(parents=True, exist_ok=True)
    fh = open(paths["home"] / ".lock", "a")
    try:
        deadline = time.monotonic() + wait_s
        waiting = False
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError(f"another samurai process holds the lock {paths['home'] / '.lock'}") from None
                if not waiting:
                    print(f"  [i] Waiting for another samurai process (lock {paths['home'] / '.lock'})...")
                    waiting = True
                time.sleep(0.1)
        yield
    finally:
        fh.close()


# --- Install manifest ----------------------------------------------------------

def _manifest_path(paths):
    return paths["home"] / "install.json"


def _load_manifest(paths):
    raw, _ = _read_regular(_manifest_path(paths))
    data = _parse_json_bytes(raw, _manifest_path(paths)) if raw is not None else {}
    if not isinstance(data, dict) or not isinstance(data.get("harnesses", {}), dict):
        raise ValueError(f"{_manifest_path(paths)} is not a Samurai install manifest")
    data.setdefault("version", 1)
    data.setdefault("selected", [])
    data.setdefault("selection_source", "auto")
    data.setdefault("roots", [])
    data.setdefault("harnesses", {})
    return data


def _save_manifest(paths, manifest):
    _update_json_file(_manifest_path(paths), lambda _old: copy.deepcopy(manifest))


def _hooks_doc(path):
    """Parsed hook config ({} when absent), validated before anything mutates it."""
    raw, _ = _read_regular(path)
    data = _parse_json_bytes(raw, path)
    _validate_hooks_doc(data, path)
    return data


def _validate_hooks_doc(data, path):
    if not isinstance(data, dict):
        raise ValueError(f"{path}: top level is not a JSON object")
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError(f"{path}: 'hooks' is not an object")
    for event, groups in hooks.items():
        if not isinstance(groups, list) or not all(isinstance(g, dict) for g in groups):
            raise ValueError(f"{path}: 'hooks.{event}' is not an array of hook groups")


def _locate(groups, record, path):
    """Index of our group in an event list: the recorded index when the group there
    is still exactly ours, else the single exact copy elsewhere. Refuses on zero
    copies (edited or removed) and on more than one copy (ambiguous)."""
    defs = [record["definition"], *record.get("previous", [])]
    hits = [i for i, g in enumerate(groups) if g in defs]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise MissingHook(f"refusing: the Order Samurai {record['event']} hook in {path} was edited or removed "
                      f"(no unmodified copy found). Restore it, or if you removed it on purpose run "
                          f"'samurai uninstall --force --keep-data' and then 'samurai install'")
    raise Refusal(f"refusing: {len(hits)} copies of the Order Samurai {record['event']} hook in {path}; "
                  f"remove the extra copies by hand, then re-run")


# --- Install ---------------------------------------------------------------------

def _plan_install(harness, data, entry, paths, manifest, config):
    """[(event, index or None to append, new definition, previous list)] for one config.
    index None means append; a known group in place is replaced at its index."""
    hooks = data.get("hooks", {})
    known = _known_definitions(harness, _owned_roots(paths, manifest))
    plan = []
    for event, definition in hook_definitions(harness, paths["root"]):
        groups = hooks.get(event, [])
        record = next((r for r in (entry or {}).get("groups", []) if r["event"] == event), None)
        if record is not None:
            index = _locate(groups, record, config)
            previous = list(record.get("previous", []))
        else:
            # No record: adopt an exact group an earlier Samurai wrote (manifest lost or
            # a v2.1.x install), never a lookalike. Ambiguity is refused.
            hits = [i for i, g in enumerate(groups) if g in known.get(event, [])]
            if len(hits) > 1:
                raise Refusal(f"refusing: {len(hits)} Order Samurai {event} hooks found in "
                              f"{config}; remove the extra copies by hand")
            index = hits[0] if hits else None
            previous = []
        if index is not None and groups[index] != definition and groups[index] not in previous:
            previous.append(groups[index])
        plan.append((event, index, definition, previous))
    return plan


def _apply_plan(data, plan):
    hooks = data.setdefault("hooks", {})
    records = []
    for event, index, definition, previous in plan:
        groups = hooks.setdefault(event, [])
        if index is None:
            groups.append(copy.deepcopy(definition))
            index = len(groups) - 1
        else:
            groups[index] = copy.deepcopy(definition)
        records.append({"event": event, "index": index, "definition": definition, "previous": previous})
    return data, records


def _recover_entry(entry, installing):
    """Reconcile an entry left `pending`/`removing` by an interrupted run.
    Returns the entry to keep (state installed) or None to drop it."""
    state = entry.get("state")
    if state == "installed":
        return entry
    try:
        data = _hooks_doc(Path(entry["config_path"]))
        hooks = data.get("hooks", {})
        found = [r["definition"] in hooks.get(r["event"], []) for r in entry.get("groups", [])]
        present = all(found)
    except (OSError, ValueError, UnsafeFile):
        return entry  # leave it for the user; the harness step will fail and explain
    if state == "pending":
        if present:
            return {**entry, "state": "installed"}
        prior = entry.get("prior")
        return dict(prior, state="installed") if prior else None
    if state == "removing":
        # install keeps a hook it found whole (and re-adopts a partial one); uninstall
        # resumes while ANY recorded group is left, so none is forgotten.
        if installing:
            return dict(entry, state="installed") if present else None
        return entry if any(found) else None
    return entry


def _install_harness(harness, paths, manifest):
    """Install or update one harness; returns its result text. Raises on refusal."""
    entry = manifest["harnesses"].get(harness)
    config = Path(entry["config_path"]) if entry else (
        paths["claude_settings"] if harness == "claude" else codex_home() / "hooks.json")
    data = _hooks_doc(config)
    plan = _plan_install(harness, data, entry, paths, manifest, config)
    if all(i is not None and data["hooks"][e][i] == d for e, i, d, _ in plan):
        _, records = _apply_plan(copy.deepcopy(data), plan)
        manifest["harnesses"][harness] = {"state": "installed", "config_path": str(config), "groups": records}
        _save_manifest(paths, manifest)
        return "unchanged"

    updating = any(i is not None for _, i, _, _ in plan)
    _, records = _apply_plan(copy.deepcopy(data), plan)
    pending = {"state": "pending", "config_path": str(config), "groups": records}
    if entry:
        pending["prior"] = {k: v for k, v in entry.items() if k != "prior"}
    manifest["harnesses"][harness] = pending
    _save_manifest(paths, manifest)
    _checkpoint("manifest_pending", harness=harness, path=config)

    final = {}

    def mutate(current):
        _validate_hooks_doc(current, config)
        current_plan = _plan_install(harness, current, entry, paths, manifest, config)
        current, final["records"] = _apply_plan(current, current_plan)
        return current

    if not config.parent.exists():
        config.parent.mkdir(parents=True, mode=0o700)
    _update_json_file(config, mutate, backup=(paths["backups"], CONFIG_BACKUP_LABELS[harness]))
    _checkpoint("config_written", harness=harness, path=config)
    manifest["harnesses"][harness] = {"state": "installed", "config_path": str(config),
                                      "groups": final.get("records", records)}
    _save_manifest(paths, manifest)
    _checkpoint("manifest_installed", harness=harness, path=config)
    if not updating:
        return "installed — approve it in Codex's /hooks screen" if harness == "codex" else "installed"
    if harness == "codex":
        return "updated — Codex will ask you to re-approve this hook only (in /hooks)"
    return "updated"


def _register_hooks_in_file(settings_path: Path, guard_script: str, scrubber_script: str, backups_dir: Path, target_label: str = "samurai-settings"):
    """Write the agent-agnostic record (~/.samurai/settings.json, Samurai's own file)
    in Claude Code's hook schema. Re-running replaces our entries, never duplicates."""
    ours = {GUARD_SCRIPT, SCRUBBER_SCRIPT, Path(guard_script).name, Path(scrubber_script).name}

    def mutate(data):
        if not isinstance(data, dict):
            data = {}
        hooks = data.get("hooks") if isinstance(data.get("hooks"), dict) else {}
        for event, matcher, script, timeout in (
            ("PreToolUse", GUARD_MATCHER, guard_script, GUARD_TIMEOUT_S),
            ("PostToolUse", SCRUBBER_MATCHER, scrubber_script, SCRUBBER_TIMEOUT_S),
        ):
            entries = [e for e in (hooks.get(event) or []) if not _targets_script(e, ours)]
            entries.append(_group(matcher, f"python3 {shlex.quote(script)}", timeout))
            hooks[event] = entries
        data["hooks"] = hooks
        return data

    _update_json_file(settings_path, mutate, backup=(backups_dir, target_label))


def _targets_script(entry, script_names):
    """True when a hook group's handler runs one of the named scripts (Samurai's own file only)."""
    if not isinstance(entry, dict):
        return False
    for hook in entry.get("hooks", []) or []:
        if not isinstance(hook, dict):
            continue
        try:
            parts = shlex.split(str(hook.get("command", "")))
        except ValueError:
            continue
        if parts and Path(parts[-1]).name in script_names:
            return True
    return False


def _print_results(results):
    for harness in HARNESSES:
        print(f"{HARNESS_LABELS[harness]}: {results[harness]}")



_GUARD_CLEAN_SOURCE = "prompt_injection_guard: Clean"
_GUARD_SOURCE_PREFIX = "prompt_injection_guard:"
# Older guards cut raw input at 200 chars BEFORE any redaction, so a key could
# end mid-way at the cut, too short for any secret pattern to match.
_GUARD_DETAIL_LIMIT = 200
_TRAILING_FRAGMENT = re.compile(r"[A-Za-z0-9_+/=.-]{12,}$")
_WITHHELD = "[withheld:"


def _load_guard_redactor(root: Path):
    """The guard's own _redact_secrets, so old rows get the masking new rows get."""
    spec = importlib.util.spec_from_file_location(
        "samurai_prompt_injection_guard", root / "bin" / "prompt_injection_guard.py")
    module = importlib.util.module_from_spec(spec)
    saved_path = list(sys.path)  # the guard prepends ~/.claude/scripts at import
    try:
        spec.loader.exec_module(module)
    finally:
        sys.path[:] = saved_path
    return module._redact_secrets


def _clean_guard_line(line: bytes, redact):
    """None drops the line (a Clean row). Otherwise returns the line, rewritten
    only when a guard row's detail needed masking; anything else is kept verbatim."""
    try:
        row = json.loads(line)
    except (ValueError, RecursionError):  # unparseable/pathological: keep it
        return line
    if not isinstance(row, dict):
        return line
    source, detail = row.get("source"), row.get("detail")
    if source == _GUARD_CLEAN_SOURCE:
        return None
    if not (isinstance(source, str) and source.startswith(_GUARD_SOURCE_PREFIX)
            and isinstance(detail, str)) or detail.startswith(_WITHHELD):
        return line
    masked = detail
    # Only a raw old detail sits at exactly the cut; one already carrying a marker
    # was redacted (by the fixed guard or a previous install) and is left alone.
    if len(detail) == _GUARD_DETAIL_LIMIT and "[REDACTED:" not in detail:
        masked = _TRAILING_FRAGMENT.sub("[REDACTED:truncated_token]", masked)
    masked = redact(masked)
    if masked is None:
        masked = f"{_WITHHELD} {len(detail)} chars, redaction unavailable]"
    if masked == detail:
        return line
    row["detail"] = masked
    ending = line[len(line.rstrip(b"\r\n")):]
    return json.dumps(row, ensure_ascii=False).encode("utf-8") + ending


def _clean_guard_rows(state_dir: Path, redact) -> tuple[int, int]:
    """Clean up what guards before v2.1.4 left in the kill-chain logs: drop the
    "Clean" rows logged for every tool call, and mask secrets in the detail of
    the guard's suspicious/blocked rows. Both held up to 200 chars of raw tool
    input. Covers the live logs and the copies rotation archived. Returns
    (rows removed, rows redacted). Idempotent: a file with nothing to change is
    not rewritten, and other producers' rows are kept byte for byte. A row the
    guard appends between read and replace is lost -- the fixed guard writes
    only rare suspicious rows, so that window is tiny."""
    rotated = state_dir / "logs" / "rotated"
    targets = []
    for name in ("kill_chain_unmatched", "kill_chain_events"):
        targets += [state_dir / f"{name}.jsonl", *sorted(rotated.glob(f"{name}-rotated-*.jsonl"))]
    removed = redacted = 0
    for path in targets:
        # A symlink would be replaced by a plain file, leaving the target's rows.
        if path.is_symlink() or not path.is_file():
            continue
        lines = path.read_bytes().splitlines(keepends=True)
        kept = []
        for line in lines:
            cleaned = _clean_guard_line(line, redact)
            if cleaned is None:
                removed += 1
            else:
                redacted += cleaned != line
                kept.append(cleaned)
        if kept == lines:
            continue
        tmp = path.with_name(path.name + ".purge.tmp")
        try:
            # Owner-only until copymode: the kept rows are still sensitive.
            with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as fh:
                fh.write(b"".join(kept))
            shutil.copymode(path, tmp)
            os.replace(tmp, path)
        finally:
            tmp.unlink(missing_ok=True)
    return removed, redacted


def cmd_install(args):
    paths = get_paths()
    try:
        explicit, source = _explicit_selection(args)
    except SelectionError as e:
        print(f"❌ {e}", file=sys.stderr)
        return 2
    print(f"⚔️  Installing Order Samurai v{SAMURAI_VERSION}...")

    try:
        with _state_lock(paths):
            paths["backups"].mkdir(parents=True, exist_ok=True)
            results, failed, targets = _install_locked(paths, explicit, source)
    except (TimeoutError, ValueError, UnsafeFile, ConcurrentModification, OSError) as e:
        print(f"❌ {e}")
        return 1

    _print_results(results)

    # install.sh runs `install` on every upgrade, and the zip never ships these
    # logs, so this is where rows from older guards get cleaned up.
    try:
        try:
            # The guard shipped beside this script, not SAMURAI_ROOT's copy.
            redact = _load_guard_redactor(Path(__file__).resolve().parent.parent)
        except Exception:
            redact = lambda _text: None  # noqa: E731 -- withhold rather than keep raw
        removed, redacted = _clean_guard_rows(paths["state"], redact)
        if removed:
            print(f"  [✓] Removed {removed} logged clean tool calls (raw tool input) from kill-chain logs")
        if redacted:
            print(f"  [✓] Redacted secrets in {redacted} older prompt-injection alert rows")
    except Exception as e:  # cleanup must never fail the install
        print(f"  [!] Could not clean old kill-chain log rows ({e}); remove the kill_chain_*.jsonl files in {paths['state']} by hand")

    if failed:
        print("⚠️  Installation finished with errors (see FAILED above). Fix them and re-run 'samurai install'.")
    elif not targets:
        print("   No supported harness found (Claude Code or Codex). Install one, then re-run 'samurai install'.")
    else:
        print("⚔️  Installation complete! Run 'samurai doctor' to verify system health.")
    try:
        _offer_pro_activation(args)
    except (KeyboardInterrupt, EOFError):
        print(f"\n   Skipped. Activate later with: {_self_cmd()} activate")
    except (Exception, SystemExit) as e:  # activation must never fail the install
        print(f"   Pro activation skipped ({type(e).__name__}). Activate later with: {_self_cmd()} activate")
    return 1 if failed else 0


def _dispatcher_covers_hooks(claude_settings: Path) -> bool:
    """True when the Claude hook registry beside claude_settings registers both our hooks.

    Parses the registry (no import, no execution) and requires each hook id as a dict key whose
    value names a script and the event that hook needs; ids that appear only in comments or
    strings do not count.
    """
    import ast

    try:
        registry = claude_settings.parent / "scripts" / "hook_registry.py"
        tree = ast.parse(registry.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError, RecursionError, MemoryError):
        return False
    found = set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.Dict):
            continue
        for key, value in zip(node.keys, node.values):
            if not (isinstance(key, ast.Constant) and isinstance(value, ast.Dict)):
                continue
            fields = {k.value: v.value for k, v in zip(value.keys, value.values)
                      if isinstance(k, ast.Constant) and isinstance(v, ast.Constant)}
            if isinstance(fields.get("script"), str):
                found.add((key.value, fields.get("event")))
    return {("prompt-injection-guard", "PreToolUse"), ("secret-scrubber-realtime", "PostToolUse")} <= found


def _install_locked(paths, explicit, source):
    manifest = _load_manifest(paths)
    for harness, entry in list(manifest["harnesses"].items()):
        kept = _recover_entry(entry, installing=True)
        if kept is None:
            del manifest["harnesses"][harness]
        else:
            manifest["harnesses"][harness] = kept
    remembered = explicit is None and manifest.get("selection_source") in ("flag", "env") and manifest.get("selected")
    if explicit is not None:
        selected, selection_source = explicit, source
    elif remembered:
        selected, selection_source = list(manifest["selected"]), manifest["selection_source"]
    else:
        selected, selection_source = None, "auto"

    detected = detect_harnesses()
    targets, results, failed = [], {}, False
    for harness in HARNESSES:
        present = detected[harness]["present"]
        if selected is not None and harness not in selected:
            results[harness] = "skipped (not selected)" if present else "skipped (not detected)"
        elif present:
            targets.append(harness)
        elif explicit is not None:
            results[harness] = f"FAILED — requested with {'--harness' if source == 'flag' else 'SAMURAI_HARNESS'} but not detected"
            failed = True
        elif harness == "codex" and detected["codex"]["config_only"]:
            results[harness] = "Codex config found but Codex not installed — skipped"
        else:
            results[harness] = "skipped (not detected)"

    manifest["selected"] = [h for h in HARNESSES if h in (selected if selected is not None else targets)]
    manifest["selection_source"] = selection_source
    if str(paths["root"]) not in manifest["roots"]:
        manifest["roots"].append(str(paths["root"]))
    _save_manifest(paths, manifest)

    if targets:
        # Agent-agnostic record, Samurai's own file.
        _register_hooks_in_file(paths["samurai_settings"], str(paths["root"] / "bin" / GUARD_SCRIPT),
                                str(paths["root"] / "bin" / SCRUBBER_SCRIPT), paths["backups"])
    for harness in targets:
        if harness == "claude" and _dispatcher_covers_hooks(paths["claude_settings"]):
            # The Claude hook registry's dispatcher already runs the guard and the scrubber;
            # a direct registration would run them twice (#42).
            results[harness] = ("left unchanged — Claude hook registry found: its dispatcher already "
                                "covers the guard and scrubber; leaving the Claude settings untouched")
            continue
        try:
            results[harness] = _install_harness(harness, paths, manifest)
        except (Refusal, ValueError, UnsafeFile, ConcurrentModification, OSError, KeyError) as e:
            results[harness] = f"FAILED — {e}"
            failed = True
    return results, failed, targets


# --- Doctor ---------------------------------------------------------------------

def _probe_payloads():
    """Benign and blocking probes in Claude and Codex payload shapes. The blocking
    text is assembled at runtime so this file never trips a host's own guard."""
    attack = "jail" + "break"
    codex = {"hook_event_name": "PreToolUse", "cwd": "/tmp", "session_id": "samurai-doctor",
             "turn_id": "samurai-doctor", "tool_use_id": "samurai-doctor", "model": "probe",
             "permission_mode": "default", "transcript_path": None}
    patch = "*** Begin Patch\n*** Add File: probe.txt\n+" + attack + "\n*** End Patch\n"
    fake_key = "sk-ant-" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4"
    guard = [
        ("Claude benign", {"tool_name": "Bash", "tool_input": {"command": "true"}}, 0),
        ("Claude blocking", {"tool_name": "Write", "tool_input": {"file_path": "probe.txt", "content": attack}}, 2),
        ("Codex benign", dict(codex, tool_name="Bash", tool_input={"command": "true"}), 0),
        ("Codex blocking", dict(codex, tool_name="apply_patch", tool_input={"command": patch}), 2),
    ]
    scrubber = [
        ("benign", {"tool_name": "Bash", "tool_input": {"command": "true"},
                    "tool_response": {"stdout": "", "stderr": ""}}, 0, None),
        ("secret", {"tool_name": "Bash", "tool_input": {"command": "cat .env"},
                    "tool_response": {"stdout": "KEY=" + fake_key, "stderr": ""}}, 0, "detected"),
    ]
    return guard, scrubber


def _run_packaged(script, payload, scratch):
    """Run a PACKAGED hook script with this interpreter. Its logs and any
    notification go to a scratch home, so a probe never looks like a real event."""
    env = dict(os.environ, HOME=str(scratch), SAMURAI_ROOT=str(scratch))
    env.pop("ORDER_SAMURAI_ROOT", None)
    try:
        r = subprocess.run([sys.executable, str(script)], input=json.dumps(payload), capture_output=True,
                           text=True, timeout=GUARD_TIMEOUT_S, env=env, cwd=str(scratch))
    except subprocess.TimeoutExpired:
        return None, f"timed out after {GUARD_TIMEOUT_S}s"
    except OSError as e:
        return None, f"could not start: {e}"
    return r, None


def _packaged_failures(paths, run_scrubber):
    """Failure strings from the packaged guard (and scrubber), [] when all probes pass."""
    guard_probes, scrubber_probes = _probe_payloads()
    bin_dir = paths["root"] / "bin"
    failures = {"guard": [], "scrubber": []}
    with tempfile.TemporaryDirectory(prefix="samurai-doctor-") as scratch:
        # The scrubber finds its packaged secret patterns under SAMURAI_ROOT.
        for core in (paths["root"] / "agentica_core", paths["root"].parent / "agentica_core"):
            if core.is_dir():
                (Path(scratch) / "agentica_core").symlink_to(core.resolve())
                break
        for label, payload, expected in guard_probes:
            r, err = _run_packaged(bin_dir / GUARD_SCRIPT, payload, scratch)
            if err or r.returncode != expected:
                why = err or f"exited {r.returncode}, expected {expected}"
                failures["guard"].append(f"{GUARD_SCRIPT} {label} probe {why}")
        if run_scrubber:
            for label, payload, expected, needle in scrubber_probes:
                r, err = _run_packaged(bin_dir / SCRUBBER_SCRIPT, payload, scratch)
                if err or r.returncode != expected or (needle and needle not in r.stderr):
                    why = err or (f"exited {r.returncode}, expected {expected}" if r.returncode != expected
                                  else f"did not report '{needle}'")
                    failures["scrubber"].append(f"{SCRUBBER_SCRIPT} {label} probe {why}")
    return failures


def _registration_problem(harness, entry, paths):
    """None when the recorded hooks are present exactly as recorded and current."""
    config = Path(entry["config_path"])
    if entry.get("state") != "installed":
        return f"interrupted {entry.get('state')} step recorded; run 'samurai install'"
    try:
        hooks = _hooks_doc(config).get("hooks", {})
    except (OSError, ValueError, UnsafeFile) as e:
        return f"cannot read {config}: {e}"
    current = dict(hook_definitions(harness, paths["root"]))
    for record in entry.get("groups", []):
        groups = hooks.get(record["event"], [])
        try:
            _locate(groups, {**record, "previous": []}, config)
        except Refusal:
            return (f"registration mismatch: the {record['event']} hook in {config} differs from what "
                    f"'samurai install' recorded (not executed); run 'samurai install' or restore it")
        handler = record["definition"]["hooks"]
        if len(handler) != 1 or handler[0].get("async"):
            return f"registration mismatch: {record['event']} handler is not a single synchronous command"
        if harness == "codex" and not all(re.search(record["definition"].get("matcher", ""), t)
                                          for t in ("Bash", "apply_patch")):
            return "registration mismatch: matcher does not cover both Bash and apply_patch"
        if current.get(record["event"]) != record["definition"]:
            return (f"registration mismatch: {record['event']} hook targets another install path; "
                    f"run 'samurai install'")
    return None


def _codex_trust(entry):
    """Read-only look at Codex's trust record for our hook. Never writes config.toml."""
    config_path = entry["config_path"]
    toml_path = Path(config_path).parent / "config.toml"
    record = next((r for r in entry.get("groups", []) if r["event"] == "PreToolUse"), None)
    try:  # Codex keys trust by position: use where our group is NOW, not where it was
        index = _locate(_hooks_doc(Path(config_path)).get("hooks", {}).get("PreToolUse", []),
                        {**record, "previous": []}, config_path)
    except (Refusal, ValueError, UnsafeFile, OSError, TypeError):
        return "unknown"
    if not toml_path.exists():
        return "no trust record — approve in Codex /hooks"
    try:
        import tomllib  # noqa: PLC0415 (3.11+)
        data = tomllib.loads(toml_path.read_text(encoding="utf-8"))
    except Exception:
        return "unknown"
    features = data.get("features")
    # codex_hooks is the older name of the same feature flag.
    if isinstance(features, dict) and (features.get("hooks") is False or features.get("codex_hooks") is False):
        return "hooks disabled in Codex config"
    hooks = data.get("hooks")
    trust = hooks.get("state") if isinstance(hooks, dict) else None
    record = trust.get(f"{config_path}:pre_tool_use:{index}:0") if isinstance(trust, dict) else None
    if isinstance(record, dict) and record.get("enabled") is False:
        return "hook disabled in Codex /hooks"
    if isinstance(record, dict) and record.get("trusted_hash"):
        return "trust record present — current approval unverified"
    return "no trust record — approve in Codex /hooks"


def _settings_run_samurai_scripts(settings):
    """True when any hook in a Claude settings file runs a script named like ours.
    Report-only: never used to decide what to modify or remove."""
    try:
        hooks = _hooks_doc(settings).get("hooks", {})
    except (ValueError, UnsafeFile, OSError):
        return False
    names = {GUARD_SCRIPT, SCRUBBER_SCRIPT}
    return any(Path(p).name in names for groups in hooks.values() for g in groups for p in _script_paths([g]))


def _legacy_registration(paths, manifest):
    try:
        return _adopt_unrecorded("claude", paths, manifest) is not None
    except (Refusal, ValueError, UnsafeFile, OSError):
        return False


def cmd_doctor(args):
    paths = get_paths()
    print(f"🩺 Order Samurai Doctor v{SAMURAI_VERSION}")
    print("----------------------------------------")

    total = 0
    passed = 0

    def check(name, ok, detail=""):
        nonlocal passed, total
        total += 1
        status = "[✅ PASS]" if ok else "[❌ FAIL]"
        if ok:
            passed += 1
        print(f"{status} {name}: {detail}")

    # Check 1: Python Version
    py_ok = sys.version_info >= (3, 11)
    check("Python Version", py_ok, f"Python {sys.version.split()[0]} (>= 3.11 required)")

    # Check 2: Taxonomy File
    tax_ok = paths["taxonomy"].exists()
    if tax_ok:
        try:
            with open(paths["taxonomy"]) as f:
                data = json.load(f)
                tax_ok = len(data.get("chains", [])) == 14
        except Exception:
            tax_ok = False
    check("Kill Chain Taxonomy", tax_ok, f"{paths['taxonomy']} (14 chains)")

    # Check 3: Fail-Closed Posture
    fail_open = os.environ.get("BUSHIDO_FAIL_OPEN", "false").lower() == "true"
    check("Security Posture", not fail_open, f"BUSHIDO_FAIL_OPEN={fail_open} (Fail-closed enforced)")

    # Registration is inspected as data, from what install recorded. Doctor never
    # runs a command read from any config (v2.1.3 did: a tampered entry ran).
    try:
        manifest = _load_manifest(paths)
    except (ValueError, UnsafeFile, OSError) as e:
        manifest = {"selected": [], "selection_source": "auto", "harnesses": {}}
        print(f"  [!] {e}")
    recorded = manifest["harnesses"]
    detected = detect_harnesses()
    results, problems = {}, {}
    # A Claude hook registry whose dispatcher runs both hooks also counts as registered (#42);
    # a direct registration on top of it runs every hook twice.
    dispatched = detected["claude"]["present"] and _dispatcher_covers_hooks(paths["claude_settings"])
    for harness in HARNESSES:
        label = HARNESS_LABELS[harness]
        if harness == "claude" and dispatched:
            settings = paths["claude_settings"]
            if "claude" in recorded or _settings_run_samurai_scripts(settings):
                problems[harness] = (f"registered in {settings} AND by the Claude hook registry, so each hook "
                                     f"runs twice -- remove the Order Samurai entries from {settings}")
            detail = problems.get(harness) or "guard and scrubber run through the Claude hook registry dispatcher"
            check(f"{label} Hook Registration", problems.get(harness) is None, detail)
        elif harness in recorded:
            problems[harness] = _registration_problem(harness, recorded[harness], paths)
            config = recorded[harness]["config_path"]
            detail = problems[harness] or f"Order Samurai hooks registered in {config}"
            check(f"{label} Hook Registration", problems[harness] is None, detail)
        elif harness in manifest.get("selected", []) and detected[harness]["present"]:
            results[harness] = "FAILED — not registered; run 'samurai install'"
            check(f"{label} Hook Registration", False, "NOT registered -- run 'samurai install'")
        elif manifest.get("selected") and detected[harness]["present"]:
            results[harness] = "skipped (not selected)"
        elif harness == "codex" and detected["codex"]["config_only"]:
            results[harness] = "Codex config found but Codex not installed — skipped"
        elif detected[harness]["present"]:
            hint = "NOT registered -- run 'samurai install'"
            if harness == "claude" and _legacy_registration(paths, manifest):
                hint = "registered by an older version with no install record -- run 'samurai install' to adopt it"
            results[harness] = f"FAILED — {hint}"
            check(f"{label} Hook Registration", False, hint)
        else:
            results[harness] = "skipped (not detected)"

    # Hook Execution: the PACKAGED scripts, run directly with this interpreter.
    covered = set(recorded) | ({"claude"} if dispatched else set())
    if covered:
        failures = _packaged_failures(paths, run_scrubber="claude" in covered)
        flat = failures["guard"] + failures["scrubber"]
        detail = ("packaged script failed — not protecting: " + "; ".join(flat) if flat else
                  f"packaged guard{' and scrubber' if 'claude' in covered else ''} passed every probe "
                  f"(run directly with {sys.executable})")
        check("Hook Execution", not flat, detail)
    else:
        failures = {"guard": [], "scrubber": []}
        check("Hook Execution", False, "no harness registered -- run 'samurai install'")

    for harness in sorted(covered, key=HARNESSES.index):
        if problems.get(harness):
            results[harness] = f"FAILED — {problems[harness]}"
        elif failures["guard"] or (harness == "claude" and failures["scrubber"]):
            results[harness] = "FAILED — packaged hook script failed; not protecting"
        elif harness == "codex":
            results[harness] = f"{CODEX_NOT_VERIFIED} — {_codex_trust(recorded[harness])}"
        elif harness not in recorded:
            results[harness] = "registered through the Claude hook registry; packaged guard and scrubber working"
        else:
            results[harness] = "registered; packaged guard and scrubber working"

    # Path Authority
    agentica_core_dir = paths["root"] / "agentica_core"
    if not agentica_core_dir.is_dir():
        agentica_core_dir = paths["root"].parent / "agentica_core"
    root_ok = paths["root"].exists() and agentica_core_dir.is_dir()
    check("Path Authority", root_ok, f"Root: {paths['root']}")

    print("----------------------------------------")
    _print_results(results)
    print(f"Summary: {passed}/{total} checks passed.")
    harness_failed = any(r.startswith("FAILED") for r in results.values())
    return 0 if passed == total and not harness_failed else 1


# --- Uninstall --------------------------------------------------------------------

def _script_paths(definitions):
    """Script paths our definitions run (the last word of each handler command)."""
    found = set()
    for definition in definitions:
        for hook in definition.get("hooks", []):
            try:
                parts = shlex.split(str(hook.get("command", "")))
            except ValueError:
                continue
            if parts:
                found.add(parts[-1])
    return found


def _runs_any(group, scripts):
    return bool(_script_paths([group]) & scripts) if isinstance(group, dict) else False


def _uninstall_harness(harness, entry, paths, manifest, force):
    """Remove our recorded groups from one harness config. Returns status text;
    raises Refusal / ValueError / UnsafeFile on anything it will not do."""
    config = Path(entry["config_path"])
    hooks = _hooks_doc(config).get("hooks", {})
    remove = []
    for record in entry.get("groups", []):
        groups = hooks.get(record["event"], [])
        try:
            _locate(groups, record, config)
            remove.append(record)
        except MissingHook:
            # --force (or a removal this command already started) may forget a group
            # that is gone. The check below refuses if an edited copy still runs it.
            if not (force or entry.get("state") == "removing"):
                raise
    shifted = {}

    def mutate(current):
        # Re-checked on every attempt: a hook appended since the first read would
        # otherwise lose its Codex approval without --force.
        _validate_hooks_doc(current, config)
        current_hooks = current.get("hooks", {})
        for record in remove:
            groups = current_hooks.get(record["event"], [])
            index = _locate(groups, record, config)
            later = len(groups) - index - 1
            if harness == "codex" and later and not force:
                raise Refusal(f"refusing: removing the Order Samurai hook would make Codex re-ask approval for "
                              f"{later} later hook(s) in {config}; re-run 'samurai uninstall --force' to remove it anyway")
            shifted[record["event"]] = later
            del groups[index]
        return current

    # Refuse before recording any state change: after removal, nothing in this config may
    # still run a Samurai script (an edited copy would). Deleting ~/.samurai would leave
    # it pointing at scripts that are gone, and a missing script blocks every tool call.
    scripts = _script_paths([d for r in entry.get("groups", []) for d in (r["definition"], *r.get("previous", []))])
    remaining = mutate(copy.deepcopy(_hooks_doc(config))) if remove else _hooks_doc(config)
    for event, groups in remaining.get("hooks", {}).items():
        if any(_runs_any(g, scripts) for g in groups):
            raise Refusal(f"refusing: an edited copy of the Order Samurai {event} hook in {config} still "
                          f"runs a Samurai script; remove it by hand, then re-run")
    if not remove:
        del manifest["harnesses"][harness]
        _save_manifest(paths, manifest)
        return "removed (the hook was already gone)"
    manifest["harnesses"][harness] = dict(entry, state="removing")
    _save_manifest(paths, manifest)
    _checkpoint("manifest_removing", harness=harness, path=config)
    _update_json_file(config, mutate, backup=(paths["backups"], CONFIG_BACKUP_LABELS[harness]))
    _checkpoint("config_removed", harness=harness, path=config)
    del manifest["harnesses"][harness]
    _save_manifest(paths, manifest)
    _checkpoint("manifest_deleted", harness=harness, path=config)
    later = shifted.get("PreToolUse", 0) if harness == "codex" else 0
    return "removed" + (f" — Codex will re-ask approval for {later} later hook(s)" if later else "")


def _adopt_unrecorded(harness, paths, manifest):
    """A manifest-shaped entry for exact Samurai groups with no record (a v2.1.x Claude
    install, or a lost install.json), or None. Lookalikes are never adopted."""
    config = paths["claude_settings"] if harness == "claude" else codex_home() / "hooks.json"
    if not config.exists() and not config.is_symlink():
        return None
    hooks = _hooks_doc(config).get("hooks", {})
    known = _known_definitions(harness, _owned_roots(paths, manifest))
    groups = []
    for event, defs in known.items():
        hits = [i for i, g in enumerate(hooks.get(event, [])) if g in defs]
        if len(hits) > 1:
            raise Refusal(f"refusing: {len(hits)} Order Samurai {event} hooks in {config}; remove extras by hand")
        if hits:
            groups.append({"event": event, "index": hits[0], "definition": hooks[event][hits[0]], "previous": []})
    if not groups:
        return None
    return {"state": "installed", "config_path": str(config), "groups": groups}


def cmd_uninstall(args):
    paths = get_paths()
    force = bool(getattr(args, "force", False))
    print(f"⚔️  Uninstalling Order Samurai v{SAMURAI_VERSION}...")
    results, failed = {}, False
    try:
        with _state_lock(paths):
            manifest = _load_manifest(paths)
            for harness in HARNESSES:
                label = HARNESS_LABELS[harness]
                try:
                    entry = manifest["harnesses"].get(harness)
                    if entry is not None:
                        kept = _recover_entry(entry, installing=False)
                        if kept is None:
                            del manifest["harnesses"][harness]
                            _save_manifest(paths, manifest)
                            results[harness] = "removed"
                            continue
                        entry = manifest["harnesses"][harness] = kept
                    elif harness == "claude":
                        entry = _adopt_unrecorded(harness, paths, manifest)
                    else:
                        # A broken Codex file Samurai never recorded is the user's to fix,
                        # not a reason to fail the uninstall.
                        try:
                            entry = _adopt_unrecorded(harness, paths, manifest)
                        except (Refusal, ValueError, UnsafeFile, OSError) as e:
                            results[harness] = f"not installed (could not inspect it: {e})"
                            continue
                    if entry is not None:
                        manifest["harnesses"][harness] = entry
                    if entry is None:
                        results[harness] = "not installed"
                        continue
                    results[harness] = _uninstall_harness(harness, entry, paths, manifest, force)
                except (Refusal, ValueError, UnsafeFile, ConcurrentModification, OSError, KeyError) as e:
                    results[harness] = f"FAILED — {e}"
                    failed = True
                    print(f"  [!] {label}: deregistration failed; kept {paths['home']} for recovery.")

            # v1.0.0's file: nothing in it is provably ours any more, so it is left
            # alone; an unreadable one is still reported rather than ignored.
            legacy = paths["claude_hooks"] / "settings.json"
            if legacy.exists():
                try:
                    _parse_json_bytes(_read_regular(legacy)[0], legacy)
                except (ValueError, UnsafeFile, OSError) as e:
                    if not results["claude"].startswith("FAILED"):
                        results["claude"] = f"FAILED — {e}"
                    failed = True

            # Samurai's own agent-agnostic record.
            if paths["samurai_settings"].exists():
                ours = {GUARD_SCRIPT, SCRUBBER_SCRIPT}

                def strip(data):
                    if not isinstance(data, dict):
                        raise ValueError(f"{paths['samurai_settings']}: not a JSON object")
                    hooks = data.get("hooks") if isinstance(data.get("hooks"), dict) else {}
                    for event in list(hooks):
                        hooks[event] = [e for e in (hooks[event] or []) if not _targets_script(e, ours)]
                    return data

                try:
                    _update_json_file(paths["samurai_settings"], strip)
                except (ValueError, UnsafeFile, ConcurrentModification, OSError) as e:
                    print(f"  [!] Could not deregister hooks from {paths['samurai_settings']}: {e}")
                    failed = True

            _print_results(results)
            if failed:
                print(f"⚠️  Uninstall incomplete: kept {paths['home']} (install record and backups) for recovery.")
                return 1
            # Still under the lock, so a waiting install cannot write into a directory
            # that is being deleted.
            return _remove_state(paths, args.keep_data)
    except (TimeoutError, ValueError, UnsafeFile, OSError) as e:
        print(f"❌ {e}")
        return 1


def _remove_state(paths, keep_data):
    """Data cleanup. license.json is a paid entitlement -- preserve a copy rather
    than silently destroying it with the state directory."""
    if not keep_data and paths["home"].exists():
        license_file = paths["home"] / "license.json"
        if license_file.exists():
            rescued = Path.home() / "order-samurai-license-backup.json"
            try:
                shutil.copy2(license_file, rescued)
                print(f"  [✓] Saved your Pro license to {rescued}")
            except Exception as e:
                print(f"  [!] Could not preserve license.json: {e}")
                print("  [!] Aborting removal so your license is not lost. Re-run with --keep-data.")
                return 1
        shutil.rmtree(paths["home"])
        print("  [✓] Removed ~/.samurai state (Zero-residue audit PASS).")
    elif keep_data:
        print("  [i] Kept ~/.samurai data (--keep-data specified).")

    print("⚔️  Order Samurai uninstalled cleanly.")
    return 0

def main():
    parser = argparse.ArgumentParser(description="Order Samurai Governance CLI")
    subparsers = parser.add_subparsers(dest="command")

    # install
    inst_parser = subparsers.add_parser("install", help="Install & register Order Samurai hooks")
    inst_parser.add_argument("--no-activate", action="store_true",
                             help="Do not offer to activate a Pro license key")
    inst_parser.add_argument("--harness", default=None,
                             help="Install only for these harnesses: claude, codex or claude,codex "
                                  "(default: every detected harness; also SAMURAI_HARNESS)")

    # doctor
    subparsers.add_parser("doctor", help="Run diagnostic health checks")

    # uninstall
    un_parser = subparsers.add_parser("uninstall", help="Uninstall Order Samurai hooks and restore settings")
    un_parser.add_argument("--keep-data", action="store_true", help="Preserve ~/.samurai state directory")
    un_parser.add_argument("--force", action="store_true",
                           help="Remove the Codex hook even when later hooks will need re-approval")

    # activate / deactivate / license
    act_parser = subparsers.add_parser("activate", help="Activate an Order Samurai Pro license key")
    act_parser.add_argument("license_key", nargs="?", default=None,
                            help="Optional; omit it to paste the key hidden (keeps it out of shell history)")
    act_parser.add_argument("--instance-name", default=None, help="Name for this machine (defaults to hostname)")

    subparsers.add_parser("deactivate", help="Deactivate Pro on this machine (revert to Free)")
    lic_parser = subparsers.add_parser("license", help="Show the current license tier and entitlement status")
    lic_parser.add_argument("--refresh", action="store_true",
                            help="Re-check the license with the payment provider now (detects refunds)")

    args = parser.parse_args()
    if not args.command or args.command == "doctor":
        sys.exit(cmd_doctor(args))
    elif args.command == "install":
        sys.exit(cmd_install(args))
    elif args.command == "uninstall":
        sys.exit(cmd_uninstall(args))
    elif args.command == "activate":
        sys.exit(cmd_activate(args))
    elif args.command == "deactivate":
        sys.exit(cmd_deactivate(args))
    elif args.command == "license":
        sys.exit(cmd_license(args))
    else:
        parser.print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
